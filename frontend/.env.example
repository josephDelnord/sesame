# Configuration locale du frontend — copier en .env et adapter si besoin

# URL de base de l'API backend. Vide = même origine (le serveur de dev Vite
# proxifie /api vers http://localhost:4000 conformément à vite.config.ts).
# Exemple pour un backend sur une autre machine :
# VITE_API_URL=http://192.168.1.20:4000
VITE_API_URL=
