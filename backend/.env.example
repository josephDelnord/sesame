# --- Serveur ---
PORT=4000

# --- Sel statique de génération des mots de passe (OBLIGATOIRE) ---
# Clé HMAC-SHA256 (64 caractères hexadécimaux recommandés).
# TOUS les mots de passe utilisent ce sel. Sans lui, impossible de générer
# ou recalculer un mot de passe, même avec les bons SN et code client.
# Générez-en une avec : openssl rand -hex 64
PASSWORD_SECRET_KEY=

# --- CRM de l'entreprise (optionnel) ---
# URL de base du CRM ; si vide ou absent, le connecteur CRM est désactivé
# et /api/resolve se contente de la base locale.
CRM_API_URL=https://crm.exemple.fr/api
# Chemin de recherche dans le CRM (par défaut : /search)
CRM_SEARCH_PATH=/search
# Clé d'API envoyée en en-tête "Authorization: Bearer ..." (optionnelle)
CRM_API_KEY=

# --- Administration (optionnel) ---
# Code requis pour la régénération d'un mot de passe
# (POST /api/records/:id/regenerate) ; si vide, la fonctionnalité est désactivée.
ADMIN_TOKEN=
