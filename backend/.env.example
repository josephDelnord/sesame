# Backend — Configuration locale
# Copiez ce fichier en .env pour personnaliser les variables
# Ne versionnez pas votre fichier .env (il est dans .gitignore)

# Port du serveur
PORT=4000

# CRM de l'entreprise (optionnel)
# Laissez CRM_API_URL vide pour désactiver le connecteur CRM
CRM_API_URL=
CRM_SEARCH_PATH=/search
CRM_API_KEY=
