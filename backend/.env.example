# Backend — Configuration locale
# Copiez ce fichier en .env pour personnaliser les variables
# Ne versionnez pas votre fichier .env (il est dans .gitignore)

# --- Serveur ---
PORT=4000

# --- HashiCorp Vault (obligatoire) ---
# En développement : Vault est géré par Docker Compose (voir .env à la racine)
# En production : utilise AppRole via VAULT_ROLE_ID_FILE et VAULT_SECRET_ID_FILE
# (montés via volumes Docker, pas besoin de VAULT_ADDR/VAULT_TOKEN ici)

# --- CRM de l'entreprise (optionnel) ---
# Laissez CRM_API_URL vide pour désactiver le connecteur CRM
CRM_API_URL=
CRM_SEARCH_PATH=/search
CRM_API_KEY=
