# --- Serveur ---
PORT=4000

# --- HashiCorp Vault (OBLIGATOIRE en production) ---
# En développement : Vault est géré par Docker Compose (voir .env à la racine)
# En production : configurez VAULT_ADDR et utilisez AppRole
#
# URL du serveur Vault (ex: http://127.0.0.1:8200 ou https://vault.example.com)
VAULT_ADDR=
# Token d'authentification Vault (optionnel, pour dev sans AppRole)
VAULT_TOKEN=

# Le PASSWORD_SECRET_KEY est stocké dans Vault à secret/data/sesame (KV v2).
# Il n'est PLUS stocké dans ce fichier.

# --- CRM de l'entreprise (optionnel) ---
# URL de base du CRM ; si vide ou absent, le connecteur CRM est désactivé
# et /api/resolve se contente de la base locale.
CRM_API_URL=https://crm.exemple.fr/api
# Chemin de recherche dans le CRM (par défaut : /search)
CRM_SEARCH_PATH=/search
# Clé d'API envoyée en en-tête "Authorization: Bearer ..." (optionnelle)
CRM_API_KEY=

# --- Administration (optionnel) ---
# Code requis pour la régénération d'un mot de passe
# (POST /api/records/:id/regenerate).
# L'ADMIN_TOKEN est maintenant stocké dans Vault à secret/data/sesame
# et récupéré automatiquement. Pas de configuration nécessaire ici.
# Pour générer un nouveau token :
#   vault kv put secret/data/sesame admin_token="votre-nouveau-token"
