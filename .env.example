# Sésame — Configuration Docker Compose
# Copiez ce fichier en .env et adaptez les valeurs selon votre environnement

# Ports des services
FRONTEND_PORT=3000
BACKEND_PORT=4000
VAULT_PORT=8200

# Adresse Vault (utilisée dans les conteneurs)
# Pour développement : http://vault:8200 (nom du service dans le réseau Docker)
# Pour production : https://vault.prod.internal:8200 (Vault externe)
# Note : les conteneurs communiquent via le nom du service 'vault'
VAULT_ADDR=http://vault:8200

# Token root Vault (optionnel, uniquement pour les tests d'intégration)
# Généré automatiquement par le conteneur Vault en mode dev
# VAULT_ROOT_TOKEN=
