# Sésame — Configuration Docker Compose
# Copiez ce fichier en .env pour personnaliser les variables
# Ne versionnez pas votre fichier .env (il est dans .gitignore)

# --- Ports des services ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
VAULT_PORT=8200

# --- Vault (obligatoire) ---
# Adresse du serveur Vault pour les conteneurs Docker
# En développement : utilisez le nom du service Docker (vault)
# En production : utilisez l'URL de votre Vault externe
VAULT_ADDR=http://vault:8200

# Token root Vault (optionnel, uniquement pour les tests d'intégration)
# Généré automatiquement par le conteneur Vault en mode dev
# VAULT_ROOT_TOKEN=
